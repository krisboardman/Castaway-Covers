{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build:next": {
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "NEXT_PUBLIC_SHOPIFY_DOMAIN",
        "NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN"
      ]
    },
    "dev:next": {
      "cache": false,
      "persistent": true
    },
    "lint": {}
  }
}